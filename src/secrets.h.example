#pragma once

// Copy this file to secrets.h and fill in your credentials.
// secrets.h is gitignored and will not be committed.

// Initial WiFi network. These are only first-boot seed values — the SSID and
// password can be changed at runtime via the web config portal (stored in NVS).
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Password for the "AmbientMonitor-setup" fallback access point (min 8 chars).
// Anyone who joins it can change the device's settings, so make it unique.
// Also used as the OTA upload password unless OTA_PASSWORD is defined below.
#define AP_PASSWORD "your-setup-ap-password"

// Optional: separate password for over-the-air firmware uploads. If you set
// it, put the same value in secrets.ini (see secrets.ini.example).
// #define OTA_PASSWORD "your-ota-password"
